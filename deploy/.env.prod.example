# ┌─────────────────────────────────────────────────────────────────────┐
# │  BYOK 生产环境变量示例                                               │
# │  复制为 .env 并填写实际值后再启动：                                  │
# │    cp .env.prod.example .env                                        │
# │    # 编辑 .env，填入下方生成命令的输出值                            │
# │    docker compose -f docker-compose.prod.yml --env-file .env up -d │
# └─────────────────────────────────────────────────────────────────────┘

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# 生成强密码：openssl rand -hex 24
POSTGRES_USER=byok
POSTGRES_PASSWORD=change_me_please
POSTGRES_DB=byok

# ── 数据库连接（指向 compose 内 postgres 服务名）────────────────────────────
# 格式：postgres://<user>:<password>@postgres:5432/<db>
DATABASE_URL=postgres://byok:change_me_please@postgres:5432/byok

# ── 信封加密主密钥（32 字节，base64 编码）────────────────────────────────────
# 生成：openssl rand -base64 32
# 重要：丢失此值将导致所有渠道凭证不可解密！请务必备份。
MASTER_KEY=change_me_32bytes_base64_encoded==

# ── Console 会话签名密钥（≥32 字符随机字符串）────────────────────────────────
# 生成：openssl rand -hex 32
SESSION_SECRET=change_me_session_secret_at_least_32_chars

# ── 服务端口（宿主映射；验收用 18080/13000 避免冲突）─────────────────────────
# 默认值：8080（gateway）、3000（console）
GATEWAY_PORT=8080
CONSOLE_PORT=3000

# ── 初始管理员账号（仅供 seed 服务使用）────────────────────────────────────────
# v1 Console 暂无改密功能；修改管理员密码：重跑 seed（SEED_ADMIN_PASSWORD）或
# SQL 更新 users.password_hash（用 @byok/shared hashPassword 生成）
SEED_ADMIN_EMAIL=admin@example.com
# 生成：openssl rand -hex 12
SEED_ADMIN_PASSWORD=change_me_admin_password
